# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ── Cloudinary (imágenes) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Email / Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@tudominio.com
RESEND_TEST_RECIPIENT=

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://tu-frontend.vercel.app
VITE_API_URL=https://tu-backend.railway.app

# ── Wompi (pasarela de pagos) ─────────────────────────────────────────────────
# Obtener en: comercios.wompi.co → Desarrolladores → Llaves API
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_KEY=test_events_secret_xxxxxxxxxxxxxxxx
# La llave privada de Wompi va SOLO en Railway, nunca en el repo
# Variable: WOMPI_SECRET_KEY=prv_test_...

# ── Wompi Payouts (Sprint 6 — liquidaciones a vendedores) ────────────────────
WOMPI_PAYOUTS_API_KEY=
WOMPI_PAYOUTS_ACCOUNT_ID=

# ── Misc ──────────────────────────────────────────────────────────────────────
ALLOW_ANY_EMAIL=false
